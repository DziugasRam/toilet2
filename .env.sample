# Required runtime state. Use an absolute, service-owned path.
TOILET_DATABASE_URL=sqlite:////var/lib/lmio-toilet/toilet.db

# Set to /toilet when nginx mounts this application below the CMS hostname.
TOILET_ROOT_PATH=
TOILET_PUBLIC_ORIGIN=https://contest.example.org
TOILET_COOKIE_SECURE=true
TOILET_SESSION_TTL_SECONDS=28800

# CMS ContestWebServer. Multiple names are comma-separated.
TOILET_CMS_BASE_URL=http://127.0.0.1:8888
TOILET_CMS_CONTESTS=contest1
TOILET_CMS_MULTI_CONTEST=false
TOILET_CMS_TIMEOUT_SECONDS=5
TOILET_CMS_POSITIVE_CACHE_SECONDS=30
TOILET_CMS_NEGATIVE_CACHE_SECONDS=3
TOILET_CMS_CACHE_MAX_ENTRIES=4096
TOILET_CMS_PROBE_RATE_LIMIT_COUNT=60
TOILET_CMS_PROBE_RATE_LIMIT_WINDOW_SECONDS=60
TOILET_CMS_SOCKET_MAX_AGE_SECONDS=300

# Dedicated Olimp-control toilet service API. This key must match
# CTRL_TOILET_AUTH_KEY, must contain at least 32 UTF-8 bytes in production,
# and must not be the managed-machine CTRL_AUTH_KEY.
TOILET_CONTROL_BASE_URL=http://127.0.0.1:8001
TOILET_CONTROL_AUTH_KEY=replace-with-dedicated-random-key
TOILET_CONTROL_TIMEOUT_SECONDS=5

# Contestant-facing pages. Disabled by default: the toilet root then serves a
# staff-only notice and proctors queue toilet breaks from the class layout. Turn
# this on only after CMS student login and every contestant translation have been
# verified for the deployment, and set CMS "toilet_url" at the same time.
TOILET_STUDENT_UI_ENABLED=false

# Optional contestant support requests, comma-separated. Disabled by default:
# unset or empty hides the optional-request form entirely and makes the service
# reject every non-toilet request type. Toilet requests are always available.
# Supported opt-in value: paper ("Additional paper").
TOILET_GENERAL_REQUEST_TYPES=

TOILET_STUDENT_RATE_LIMIT_COUNT=10
TOILET_STUDENT_RATE_LIMIT_WINDOW_SECONDS=60
TOILET_OPERATOR_LOGIN_RATE_LIMIT_COUNT=10
TOILET_OPERATOR_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Operator credentials are stored only in this database. There is intentionally
# no bootstrap password setting; use `python -m toilet2.manage_operator`.
